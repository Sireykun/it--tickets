# Production settings for docker-compose.prod.yml. Copy to .env.prod (git-ignored) and fill in.
# Generate secrets with: openssl rand -hex 32
# Keep values URL-safe (letters, digits, - and _): POSTGRES_PASSWORD goes into a connection URL.

# Public host name. Caddy fetches its HTTPS certificate for it.
APP_DOMAIN=helpdesk.ciaschool.edu.kh

# Database
POSTGRES_USER=ticket
POSTGRES_PASSWORD=
POSTGRES_DB=ticketdb

# Sign-in
AUTH_SECRET=
# Google Workspace SSO. Add https://<APP_DOMAIN>/api/auth/callback/google as a redirect URI.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAIL_DOMAIN=ciaschool.edu.kh
APP_TIME_ZONE=Asia/Phnom_Penh

# First admin account, used only by `npm run db:seed`. Remove the password after the first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Email (Google Workspace). Use an app password for the helpdesk mailbox.
EMAIL_OUTBOUND=on
EMAIL_TOKEN_SECRET=
MAIL_FROM=CIA IT Helpdesk <helpdesk@ciaschool.edu.kh>
HELPDESK_ADDRESS=helpdesk@ciaschool.edu.kh
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=helpdesk@ciaschool.edu.kh
SMTP_PASS=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=helpdesk@ciaschool.edu.kh
IMAP_PASS=
INBOUND_HELP_TOPIC=Other

# Backups: where dumps land on this machine, how long to keep them, and when (cron, UTC).
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_CRON=0 19 * * *
